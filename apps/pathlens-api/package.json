{
  "name": "@pathlens/api",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "build": "pnpm --filter @workspace/contracts build && pnpm --filter @workspace/backend-types build && tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "backfill:campaigns": "tsx --env-file=.env src/scripts/backfill-campaign-attribution.ts",
    "test:geoip": "tsx --test src/lib/geoip.test.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.850.0",
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@workspace/backend-types": "workspace:*",
    "@workspace/contracts": "workspace:*",
    "aws-serverless-express": "^3.4.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "geoip-lite": "^2.0.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.10",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
