{
  "name": "pathlens-airship",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run lint typecheck build",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\"",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "clean": "turbo run clean",
    "layer": "node scripts/build-lambda-layer.mjs",
    "deploy:notifications": "node scripts/deploy-notifications.mjs",
    "deploy:notifications:staging": "node scripts/deploy-notifications.mjs --target staging",
    "deploy:heatmap-proxy": "node scripts/deploy-image.mjs --dockerfile apps/pathlens-heatmap-proxy/Dockerfile --repository pathlens/heatmap-proxy --function pathlens-heatmap-proxy",
    "deploy:snapshot-worker": "node scripts/deploy-image.mjs --dockerfile apps/pathlens-snapshot-worker/Dockerfile --repository pathlens/snapshot-worker --function pathlens-snapshot-worker",
    "deploy:pathlens-api": "node scripts/deploy-image.mjs --dockerfile apps/pathlens-api/Dockerfile --repository pathlens/api --function pathlens-api-dev",
    "ecr-login": "aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 176246209215.dkr.ecr.ap-south-1.amazonaws.com"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12"
  }
}
